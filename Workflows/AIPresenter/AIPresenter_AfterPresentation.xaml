            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[int_PlaySlideVideoShellResult]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[Microsoft.VisualBasic.Interaction.Shell(Chr(34) + str_PythonExe + Chr(34) + &quot; &quot; + Chr(34) + str_PlayVideoScript + Chr(34) + &quot; --path &quot; + Chr(34) + str_SlideVideoPath + Chr(34) + &quot; --ffmpeg &quot; + Chr(34) + str_FfmpegPath + Chr(34), Microsoft.VisualBasic.AppWinStyle.NormalFocus, True)]</InArgument>
            </Assign.Value>
          </Assign>
        </If.Then>
      </If>
      <Assign sap:VirtualizedContainerService.HintSize="200,200" sap2010:WorkflowViewState.IdRef="Assign_PresentationContextAfterPresentation">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[str_CurrentSlideContent]</OutArgument>
        </Assign.To>
        <Assign.Value>
